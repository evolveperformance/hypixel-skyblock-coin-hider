{
  "schemaVersion": 1,
  "id": "coinhider",
  "version": "${version}",
  "name": "Hypixel SkyBlock Coin Hider",
  "description": "Hides coin drops on the ground in Hypixel SkyBlock, like the coins from the Coin Talisman. No pickup animation either. Client-side, no config.",
  "authors": [
    "Luca"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.coinhider.CoinHider"
    ]
  },
  "mixins": [
    "coinhider.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "${mc_compat}",
    "fabric-api": "*",
    "java": ">=25"
  },
  "contact": {
    "sources": "https://github.com/evolveperformance/hypixel-skyblock-coin-hider",
    "issues": "https://github.com/evolveperformance/hypixel-skyblock-coin-hider/issues",
    "homepage": "https://modrinth.com/mod/hypixel-skyblock-coin-hider"
  },
  "icon": "assets/coinhider/icon.png"
}