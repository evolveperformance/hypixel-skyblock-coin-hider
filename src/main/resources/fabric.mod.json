{
  "schemaVersion": 1,
  "id": "coinhider",
  "version": "${version}",
  "name": "Hypixel Skyblock Cheap Coins Hider",
  "description": "Hides coins on the floor generated by the Coin Talisman in Hypixel Skyblock. Only active while in SkyBlock. Render-only. /coinhider to toggle.",
  "authors": [
    "Luca"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.coinhider.CoinHider"
    ]
  },
  "mixins": [
    "coinhider.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~26.1",
    "fabric-api": "*",
    "java": ">=25"
  },
  "contact": {
    "sources": "https://github.com/evolveperformance/hypixel-skyblock-cheap-coins-hider",
    "issues": "https://github.com/evolveperformance/hypixel-skyblock-cheap-coins-hider/issues"
  },
  "icon": "assets/coinhider/icon.png"
}